# ============================================================
#  Archive — Production .env (DO NOT COMMIT)
#  All secrets are 50-character hex strings.
#  Generate new ones for production:  node scripts/genkeys.js
# ============================================================

NODE_ENV=production
PORT=3000

# Public origin of the deployed frontend (used for CORS + cookies)
PUBLIC_ORIGIN=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example

# ===== JWT =====
JWT_ACCESS_SECRET=GENERATE_WITH_NPM_RUN_GENKEYS
JWT_REFRESH_SECRET=GENERATE_WITH_NPM_RUN_GENKEYS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Session / CSRF / Cookies =====
CSRF_SECRET=GENERATE_WITH_NPM_RUN_GENKEYS
SESSION_SECRET=GENERATE_WITH_NPM_RUN_GENKEYS
COOKIE_SECRET=GENERATE_WITH_NPM_RUN_GENKEYS

# ===== ADMIN account =====
# Username is plain. Password MUST be bcrypt hash (cost >= 12).
# Generate hash:  node scripts/hash.js <plain-password>
ADMIN_USERNAME=archive-admin
ADMIN_PASSWORD_HASH=GENERATE_WITH_NPM_RUN_HASH
# Never place plaintext passwords in this file or in an APK.

# ===== Firebase Realtime DB =====
FIREBASE_DB_URL=https://your-project.firebaseio.com
FIREBASE_DB_SECRET=

# ===== Cloudinary (SIGNED uploads only) =====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Unsigned preset is DEPRECATED — kept only as a fallback for legacy clients
CLOUDINARY_UPLOAD_PRESET=

# ===== Rate limiting =====
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=20

# ===== Misc =====
TRUST_PROXY=1
FORCE_HTTPS=true
SELF_URL=
