# ============================================================
#  Qarfash / Atheer — Production .env (DO NOT COMMIT)
#  All secrets are 50-character hex strings.
#  Generate new ones for production:  node scripts/genkeys.js
# ============================================================

NODE_ENV=production
PORT=3000

# Public origin of the deployed frontend (used for CORS + cookies)
PUBLIC_ORIGIN=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example

# ===== JWT =====
JWT_ACCESS_SECRET=f8ad74178d61abdc2c9953d419740374a2a1f63122a1b0585a
JWT_REFRESH_SECRET=c4c12ffe1d0b26ee2ff17000ac2dfb02be209422d82606e794
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Session / CSRF / Cookies =====
CSRF_SECRET=641d5f03abaadc9ebe405f8316f157e4c76f14d7fbfd08cf0a
SESSION_SECRET=7e331639b5e4b50c07e31b749d2b3ef3751dc5b73479412f7a
COOKIE_SECRET=089c2a1395340c9309dc94c7935261999a0a2ef6d437a8ecdf

# ===== ADMIN account =====
# Username is plain. Password MUST be bcrypt hash (cost >= 12).
# Generate hash:  node scripts/hash.js <plain-password>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$sdovPTlL2gI1tKFwZsBEROSj/bLEInWr7LKXTjdBZWuNeKWe2pVWm
# (Plaintext for the hash above — change before production)
# ADMIN_PASSWORD_PLAINTEXT=2a253f6220c652df9f04a6f3310eedf2b03e6904caad0a05e1

# ===== Firebase Realtime DB =====
FIREBASE_DB_URL=https://your-project.firebaseio.com
FIREBASE_DB_SECRET=

# ===== Cloudinary (SIGNED uploads only) =====
CLOUDINARY_CLOUD_NAME=dbcqz0yae
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Unsigned preset is DEPRECATED — kept only as a fallback for legacy clients
CLOUDINARY_UPLOAD_PRESET=

# ===== Rate limiting =====
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=20

# ===== Misc =====
TRUST_PROXY=1
FORCE_HTTPS=true
SELF_URL=
